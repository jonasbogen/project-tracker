{
  "name": "project-tracker",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Internal tool for tracking projects: status, challenges, timeline, customer, responsible owner, and linked cases. Hono API + React (Vite) frontend, served as a single app.",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3"
  }
}
