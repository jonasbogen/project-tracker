{
  "name": "project-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Internal tool for tracking projects: status, challenges, timeline, customer, responsible owner, and linked cases. Hono API + React (Vite) frontend, served as a single app.",
  "engines": {
    "node": "22.*"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "cd apps/web && vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p apps/server/tsconfig.json",
    "build:web": "cd apps/web && vite build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf apps/server/dist apps/web/dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "openai": "^7.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@intility/bifrost-css": "^6.0.0",
    "@intility/bifrost-react": "^6.0.0",
    "@intility/bifrost-react-select": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
