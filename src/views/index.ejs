<%- include('partials/header') %>

<div class="page-header">
  <h1>Prosjekter</h1>
  <a class="button" href="/projects/new">Nytt prosjekt</a>
</div>

<% if (projects.length === 0) { %>
  <p class="empty">Ingen prosjekter er registrert ennå.</p>
<% } else { %>
  <table class="project-table">
    <thead>
      <tr>
        <th>Prosjekt</th>
        <th>Kunde</th>
        <th>Status</th>
        <th>Ansvarlig</th>
        <th>Tidslinje</th>
        <th>Saker</th>
      </tr>
    </thead>
    <tbody>
      <% projects.forEach((project) => { %>
        <tr>
          <td><a href="/projects/<%= project.id %>"><%= project.name %></a></td>
          <td><%= project.customer %></td>
          <td><span class="status-badge status-<%= project.status %>"><%= project.status %></span></td>
          <td><%= project.responsible %></td>
          <td>
            <%= project.start_date ? new Date(project.start_date).toLocaleDateString('no-NO') : '–' %>
            &ndash;
            <%= project.end_date ? new Date(project.end_date).toLocaleDateString('no-NO') : '–' %>
          </td>
          <td><%= project.case_count %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
